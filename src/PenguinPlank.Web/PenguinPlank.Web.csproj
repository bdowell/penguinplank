<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <!--
    Common build settings (TFM, nullable, analyzers, warnings-as-errors) come
    from the root Directory.Build.props. Web consumes the API through a typed
    client aligned with Contracts and references Contracts only — no database
    driver, EF context, or SQL (dependency rule: coding-standards §3).
  -->

  <PropertyGroup>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.12" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.12" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PenguinPlank.Contracts\PenguinPlank.Contracts.csproj" />
  </ItemGroup>

</Project>
