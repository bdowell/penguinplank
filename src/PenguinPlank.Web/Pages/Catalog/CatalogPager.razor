<nav class="cp-pager" aria-label="@Label pagination">
    <button type="button" class="cp-button secondary" disabled="@(!HasPrevious)" @onclick="OnPrevious">Previous page</button>
    <span aria-live="polite">Page @PageNumber, @TotalCount @(TotalCount == 1 ? "result" : "results")</span>
    <button type="button" class="cp-button secondary" disabled="@(!HasNext)" @onclick="OnNext">Next page</button>
</nav>

@code {
    [Parameter, EditorRequired]
    public string Label { get; set; } = string.Empty;

    [Parameter]
    public int PageNumber { get; set; }

    [Parameter]
    public long TotalCount { get; set; }

    [Parameter]
    public bool HasPrevious { get; set; }

    [Parameter]
    public bool HasNext { get; set; }

    [Parameter]
    public EventCallback OnPrevious { get; set; }

    [Parameter]
    public EventCallback OnNext { get; set; }
}
