# Normalize line endings so the working tree matches .editorconfig (end_of_line = crlf).
# Without this, git may check out LF and `dotnet format --verify-no-changes` fails on ENDOFLINE.

# Default: let git handle text detection, but check out with CRLF on Windows checkouts.
* text=auto

# .NET / C# source and project files: always CRLF in the working tree.
*.cs text eol=crlf
*.csproj text eol=crlf
*.sln text eol=crlf
*.props text eol=crlf
*.targets text eol=crlf
*.config text eol=crlf
*.razor text eol=crlf
*.cshtml text eol=crlf
*.json text eol=crlf
*.editorconfig text eol=crlf
*.md text eol=crlf
*.ps1 text eol=crlf
*.yml text eol=lf
*.yaml text eol=lf
*.sh text eol=lf

# Binary assets: never normalize.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.wasm binary
*.dll binary
*.exe binary
*.pdb binary
*.dat binary
